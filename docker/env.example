# Copy to .env at the repo root (docker compose reads it automatically):
#   cp docker/env.example .env
#
# REQUIRED — the app refuses to boot without it. Generate one:
#   openssl rand -hex 32
JWT_SECRET=

# Optional — raise the minimum JWT signing-key length to 64 bytes. The compose
# stack defaults this to 64 (production strict); local dev (start-dev.sh)
# keeps the 32-byte minimum.
# JWT_MIN_SECRET_BYTES=64

# Strongly recommended — raises GitHub API quota from 60 req/hr to 5,000 req/hr.
GITHUB_TOKEN=

# Optional — enables live Gemini AI summaries/roadmaps/reviews.
GEMINI_API_KEY=

# Optional — enables recruiter AI job-match explanations. A shared secret that
# auth-service sends to github-service's internal /api/ai/job-match endpoint
# (header X-Internal-Api-Key). Generate one, e.g. openssl rand -hex 32, and set
# the SAME value on both services (docker-compose wires it automatically).
# When unset, recruiter AI explanations are skipped (deterministic ranking only).
# INTERNAL_API_KEY=

# Optional — GitHub OAuth sign-in. Register an OAuth App with callback
# http://localhost:8080/api/auth/oauth/github/callback  (goes through Gateway)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional — override the local defaults when the frontend/backend live elsewhere.
#   GITHUB_OAUTH_REDIRECT_URI  = public callback URL (goes through Gateway)
#                                 (default http://localhost:8080/api/auth/oauth/github/callback)
#   OAUTH_FRONTEND_REDIRECT_URI = public URL of the frontend token-consumer route
#                                 (default http://localhost:5173/auth/callback)
# GITHUB_OAUTH_REDIRECT_URI=http://localhost:8080/api/auth/oauth/github/callback
# OAUTH_FRONTEND_REDIRECT_URI=http://localhost:5173/auth/callback

# Optional — local Postgres password (defaults to postgres).
# POSTGRES_PASSWORD=

# Optional — Redis connection for the auth-service rate limiter and OAuth state
# (compose runs a bundled redis container; override REDIS_HOST to use a managed
# instance such as ElastiCache).
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Optional — point the compose stack at a production/managed PostgreSQL instead
# of the bundled container. Each service needs its own database:
#   AUTH_DATABASE_URL / GITHUB_DATABASE_URL / ANALYTICS_DATABASE_URL
# plus the shared username (DATABASE_USERNAME) and password (POSTGRES_PASSWORD,
# which the bundled postgres container uses too — set it to the external DB's
# password when pointing at one).
# AUTH_DATABASE_URL=jdbc:postgresql://db.example.com:5432/gitinsight_auth
# GITHUB_DATABASE_URL=jdbc:postgresql://db.example.com:5432/gitinsight_github
# ANALYTICS_DATABASE_URL=jdbc:postgresql://db.example.com:5432/gitinsight_analytics
# DATABASE_USERNAME=gitinsight
# POSTGRES_PASSWORD=

# Optional — override the Eureka registry URL for the services.
# (Default http://localhost:8761/eureka/; compose sets it to eureka-server automatically.)
# EUREKA_URL=http://eureka-server:8761/eureka/

# Optional — comma-separated frontend origin allowlist for CORS. Only needed
# when the frontend is hosted on a different origin than the backend.
# (Default http://localhost:5173)
# CORS_ALLOWED_ORIGINS=https://app.example.com
